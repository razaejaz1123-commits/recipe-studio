# Recipe Studio - Environment Variables
# Configure these in your Vercel Project Dashboard under:
# Settings -> Environment Variables

# Your Groq API Key (Get one free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq AI Model (Default: openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
